{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "WebExamOrigins": []
  },
  "Jwt": {
    "Issuer": "ExamProctoring.Api",
    "Audience": "ExamProctoring.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "TemporaryPasswordHours": 72
  },
  "Exams": {
    "WarningLimit": 20
  }
}
